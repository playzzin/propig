<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ProPig.Habits"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <SolidColorBrush x:Key="HabitMint" Color="#79F0B2" />
    <SolidColorBrush x:Key="HabitInk" Color="#092219" />
    <SolidColorBrush x:Key="HabitText" Color="#F2F7F4" />
    <SolidColorBrush x:Key="HabitMuted" Color="#ACC4BC" />
    <SolidColorBrush x:Key="HabitLine" Color="#375659" />
    <SolidColorBrush x:Key="HabitWidgetSurface" Color="#112326" />

    <Style x:Key="ProPigToolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HabitWidgetSurface}" />
        <Setter Property="BorderBrush" Value="#2D494B" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="HabitButton" TargetType="Button">
        <Setter Property="Background" Value="#1B3436" />
        <Setter Property="Foreground" Value="{StaticResource HabitText}" />
        <Setter Property="BorderBrush" Value="{StaticResource HabitLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource HabitMint}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitPrimaryButton" TargetType="Button" BasedOn="{StaticResource HabitButton}">
        <Setter Property="Background" Value="{StaticResource HabitMint}" />
        <Setter Property="BorderBrush" Value="{StaticResource HabitMint}" />
        <Setter Property="Foreground" Value="{StaticResource HabitInk}" />
    </Style>

    <Style x:Key="ProPigCaptionButton" TargetType="Button">
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HabitMuted}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Path x:Name="Glyph" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="12" Height="12" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonFrame" Property="Background" Value="#254145" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource HabitText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{StaticResource HabitMint}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonFrame" Property="Background" Value="#375659" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Command" Value="{x:Static SystemCommands.CloseWindowCommand}" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFrame" Property="Background" Value="#632E3A" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="#FFE1E7" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="ProPigMinimizeGlyph">M 1,6 H 11</Geometry>
    <Geometry x:Key="ProPigMaximizeGlyph">M 1,1 H 11 V 11 H 1 Z</Geometry>
    <Geometry x:Key="ProPigRestoreGlyph">M 4,4 V 1 H 11 V 8 H 8 M 1,4 H 8 V 11 H 1 Z</Geometry>
    <Geometry x:Key="ProPigCloseGlyph">M 2,2 L 10,10 M 10,2 L 2,10</Geometry>

    <Style x:Key="ProPigWindowStyle" TargetType="{x:Type local:ProPigWindow}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Background" Value="#0C181B" />
        <Setter Property="Foreground" Value="{StaticResource HabitText}" />
        <Setter Property="FontFamily" Value="맑은 고딕" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProPigWindow}">
                    <Border x:Name="Frame" BorderBrush="#31494C" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" CornerRadius="10">
                        <DockPanel>
                            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="43"
                                    Padding="9,0,5,0" Background="#15282B"
                                    BorderBrush="#2E494B" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="6" Margin="0,0,8,0"
                                                Background="#23393A" BorderBrush="#365052" BorderThickness="1">
                                            <Image Source="pack://application:,,,/Assets/ProPig.png" Width="18" Height="18"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="ProPig" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DockPanel x:Name="SurfaceLabel" Grid.Column="1" Margin="7,0,4,0" VerticalAlignment="Center">
                                        <Border DockPanel.Dock="Left" Width="1" Height="13" Background="#42605F" Margin="0,0,7,0" />
                                        <TextBlock Text="{TemplateBinding SurfaceName}"
                                                   FontSize="12" Foreground="{StaticResource HabitMuted}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource ProPigCaptionButton}" Content="{StaticResource ProPigMinimizeGlyph}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="최소화"
                                                AutomationProperties.Name="최소화" />
                                        <Button x:Name="ResizeButton" Style="{StaticResource ProPigCaptionButton}"
                                                Content="{StaticResource ProPigMaximizeGlyph}"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="최대화"
                                                AutomationProperties.Name="최대화" />
                                        <Button Style="{StaticResource ProPigCaptionButton}" Content="{StaticResource ProPigCloseGlyph}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="닫기"
                                                AutomationProperties.Name="닫기" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#63877D" />
                            <Setter TargetName="TitleBar" Property="Background" Value="#1A3033" />
                        </Trigger>
                        <Trigger Property="SurfaceName" Value="{x:Null}">
                            <Setter TargetName="SurfaceLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Frame" Property="CornerRadius" Value="0" />
                            <Setter TargetName="TitleBar" Property="CornerRadius" Value="0" />
                            <Setter TargetName="ResizeButton" Property="Content" Value="{StaticResource ProPigRestoreGlyph}" />
                            <Setter TargetName="ResizeButton" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                            <Setter TargetName="ResizeButton" Property="ToolTip" Value="이전 크기로 복원" />
                            <Setter TargetName="ResizeButton" Property="AutomationProperties.Name" Value="이전 크기로 복원" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitScrollBar" TargetType="ScrollBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Margin" Value="0,8,6,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Border Background="#1C3337" Margin="2,0" CornerRadius="4" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource HabitScrollPage}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Grip" Margin="3,0" CornerRadius="4" Background="#678A89" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Margin" Value="1,0" />
                                                    <Setter TargetName="Grip" Property="Background" Value="#91BAAD" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Grip" Property="Margin" Value="1,0" />
                                                    <Setter TargetName="Grip" Property="Background" Value="{StaticResource HabitMint}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource HabitScrollPage}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitScrollViewer" TargetType="ScrollViewer">
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Focusable="False"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Style="{StaticResource HabitScrollBar}" />
                        <Border x:Name="ListFocus" Grid.ColumnSpan="2" BorderBrush="#60847D" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ListFocus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitOption" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource HabitMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="RowFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="18" Height="18" Margin="0,0,8,0"
                                    VerticalAlignment="Center" CornerRadius="5"
                                    BorderBrush="{StaticResource HabitMuted}" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="✓" Visibility="Hidden" FontSize="12"
                                           FontWeight="Bold" Foreground="{StaticResource HabitInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource HabitMint}" />
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource HabitMint}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource HabitMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource HabitMint}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RowFrame" Property="Opacity" Value="0.58" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitRecord" TargetType="CheckBox" BasedOn="{StaticResource HabitOption}">
        <Setter Property="Content" Value="박스 체크" />
        <Setter Property="Background" Value="#1B3436" />
        <Setter Property="BorderBrush" Value="{StaticResource HabitLine}" />
        <Setter Property="Foreground" Value="{StaticResource HabitText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="완료됨" />
                <Setter Property="Background" Value="#19382E" />
                <Setter Property="BorderBrush" Value="#356552" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HabitWeekDay" TargetType="Button" BasedOn="{StaticResource HabitButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HabitMuted}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="Margin" Value="1,0,1,3" />
    </Style>

    <Style x:Key="HabitWeekDayActive" TargetType="Button" BasedOn="{StaticResource HabitWeekDay}">
        <Setter Property="Background" Value="#21403B" />
        <Setter Property="Foreground" Value="{StaticResource HabitMint}" />
    </Style>

    <Style x:Key="HabitWidgetCheck" TargetType="CheckBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="28" />
        <Setter Property="BorderBrush" Value="{StaticResource HabitLine}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="CheckFrame" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Background="#192E32" CornerRadius="6">
                        <Path x:Name="Tick" Data="M 1,5 L 4,8 L 10,1" Stroke="{StaticResource HabitInk}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckFrame" Property="Background" Value="{StaticResource HabitMint}" />
                            <Setter TargetName="CheckFrame" Property="BorderBrush" Value="{StaticResource HabitMint}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckFrame" Property="BorderBrush" Value="{StaticResource HabitMint}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckFrame" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckFrame" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckFrame" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HabitWeeklyCheck" TargetType="CheckBox" BasedOn="{StaticResource HabitWidgetCheck}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Margin" Value="1,2" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource HabitMint}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="#385457" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
