<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProPig.Habits</AssemblyName>
    <ApplicationIcon>Assets\ProPig.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ProPig.ico" />
    <Resource Include="../../public/icons/justpig-favicon-144.png" Link="Assets/ProPig.png" />
    <EmbeddedResource Include="ConnectComplete.html" LogicalName="ProPig.Habits.ConnectComplete.html" />
    <Content Include="../../scripts/rainmeter/Connect-ProPigMeasures.ps1;../../scripts/rainmeter/ExportMeasures.lua"
             Link="Rainmeter/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
</Project>
