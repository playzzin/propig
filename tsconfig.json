{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".hermes-next/types/**/*.ts",
    ".hermes-next/dev/types/**/*.ts",
    ".hermes-next-qa-webpack/types/**/*.ts",
    ".hermes-next-qa-webpack/dev/types/**/*.ts",
    ".hermes-partner-live-3002-v2/types/**/*.ts",
    ".hermes-partner-live-3002-v2/dev/types/**/*.ts",
    ".hermes-project-audit-3002-v2/types/**/*.ts",
    ".hermes-project-audit-3002-v2/dev/types/**/*.ts",
    ".hermes-project-audit-3002-v3/types/**/*.ts",
    ".hermes-project-audit-3002-v3/dev/types/**/*.ts",
    ".hermes-project-build-v1/types/**/*.ts",
    ".hermes-project-build-v1/dev/types/**/*.ts",
    ".hermes-project-build-v4/types/**/*.ts",
    ".hermes-project-build-v4/dev/types/**/*.ts",
    ".hermes-project-build-linux-v5/types/**/*.ts",
    ".hermes-project-build-linux-v5/dev/types/**/*.ts",
    ".hermes-project-build-linux-v6/types/**/*.ts",
    ".hermes-project-build-linux-v6/dev/types/**/*.ts",
    ".hermes-nav-audit-v1/types/**/*.ts",
    ".hermes-nav-audit-v1/dev/types/**/*.ts",
    ".hermes-nav-build-v1/types/**/*.ts",
    ".hermes-nav-build-v1/dev/types/**/*.ts",
    ".hermes-nav-build-v2/types/**/*.ts",
    ".hermes-nav-build-v2/dev/types/**/*.ts",
    ".hermes-nav-build-v3/types/**/*.ts",
    ".hermes-nav-build-v3/dev/types/**/*.ts",
    ".hermes-careers-qa-v1/types/**/*.ts",
    ".hermes-careers-qa-v1/dev/types/**/*.ts",
    ".hermes-careers-qa-v2/types/**/*.ts",
    ".hermes-careers-qa-v2/dev/types/**/*.ts",
    ".hermes-route-perf-dev-v1/types/**/*.ts",
    ".hermes-route-perf-dev-v1/dev/types/**/*.ts",
    ".hermes-route-perf-build-v1/types/**/*.ts",
    ".hermes-route-perf-build-v1/dev/types/**/*.ts",
    ".hermes-final-dev-v1/types/**/*.ts",
    ".hermes-final-dev-v1/dev/types/**/*.ts",
    ".hermes-final-dev-v2/types/**/*.ts",
    ".hermes-final-dev-v2/dev/types/**/*.ts",
    ".hermes-final-build-v1/types/**/*.ts",
    ".hermes-final-build-v1/dev/types/**/*.ts",
    ".hermes-final-build-v2/types/**/*.ts",
    ".hermes-final-build-v2/dev/types/**/*.ts",
    ".hermes-final-build-v3/types/**/*.ts",
    ".hermes-final-build-v3/dev/types/**/*.ts",
    ".hermes-content-restore-dev-v1/types/**/*.ts",
    ".hermes-content-restore-dev-v1/dev/types/**/*.ts",
    ".hermes-content-restore-build-v1/types/**/*.ts",
    ".hermes-content-restore-build-v1/dev/types/**/*.ts",
    ".hermes-content-restore-build-v2/types/**/*.ts",
    ".hermes-content-restore-build-v2/dev/types/**/*.ts",
    ".hermes-content-restore-build-v3/types/**/*.ts",
    ".hermes-content-restore-build-v3/dev/types/**/*.ts",
    ".hermes-content-restore-build-v4/types/**/*.ts",
    ".hermes-content-restore-build-v4/dev/types/**/*.ts",
    ".hermes-content-restore-build-v5/types/**/*.ts",
    ".hermes-content-restore-build-v5/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    ".next/dev",
    ".hermes-next/**",
    ".hermes-next-qa-webpack/**",
    ".hermes-partner-live-3002-v2/**",
    ".hermes-project-audit-3002-v2/**",
    ".hermes-project-audit-3002-v3/**",
    ".hermes-project-build-v1/**",
    ".hermes-project-build-v2/**",
    ".hermes-project-build-v3/**",
    ".hermes-project-build-v4/**",
    ".hermes-project-build-linux-v5/**",
    ".hermes-project-build-linux-v6/**",
    ".hermes-nav-audit-v1/**",
    ".hermes-nav-build-v1/**",
    ".hermes-nav-build-v2/**",
    ".hermes-nav-build-v3/**",
    ".hermes-careers-qa-v1/**",
    ".hermes-careers-qa-v2/**",
    ".hermes-route-perf-dev-v1/**",
    ".hermes-route-perf-build-v1/**",
    ".hermes-final-dev-v1/**",
    ".hermes-final-dev-v2/**",
    ".hermes-final-build-v1/**",
    ".hermes-final-build-v2/**",
    ".hermes-final-build-v3/**",
    ".hermes-content-restore-dev-v1/**",
    ".hermes-content-restore-build-v1/**",
    ".hermes-content-restore-build-v2/**",
    ".hermes-content-restore-build-v3/**",
    ".hermes-content-restore-build-v4/**",
    ".hermes-content-restore-build-v5/**",
    "functions"
  ]
}
