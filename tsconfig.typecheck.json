{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "types/next-env.typecheck.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    ".next/dev/**",
    ".hermes-next/**",
    ".hermes-next-qa-webpack/**",
    ".hermes-partner-live-3002-v1/**",
    ".hermes-partner-live-3002-v2/**",
    "functions/**",
    "src/remotion",
    "src/remotion.bak"
  ]
}
