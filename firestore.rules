rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/userAccess/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function validManagedArtifactActor(actor) {
      return actor is map &&
        actor.keys().hasAll(['uid', 'email', 'displayName']) &&
        actor.keys().hasOnly(['uid', 'email', 'displayName']) &&
        actor.uid is string && actor.uid.size() > 0 && actor.uid.size() <= 128 &&
        (actor.email == null || (actor.email is string && actor.email.size() <= 320)) &&
        (actor.displayName == null || (actor.displayName is string && actor.displayName.size() <= 120));
    }

    function validManagedArtifactOrigin(origin) {
      return origin is map &&
        origin.keys().hasAll([
          'provider', 'projectName', 'path', 'sha256', 'modifiedAt', 'importedVersion', 'syncedAt'
        ]) &&
        origin.keys().hasOnly([
          'provider', 'projectName', 'path', 'sha256', 'modifiedAt', 'importedVersion', 'syncedAt'
        ]) &&
        origin.provider == 'local-workspace' &&
        origin.projectName is string && origin.projectName.size() > 0 && origin.projectName.size() <= 120 &&
        origin.path is string && origin.path.size() > 0 && origin.path.size() <= 240 &&
        origin.sha256 is string && origin.sha256.matches('^[a-f0-9]{64}$') &&
        (
          origin.modifiedAt == null ||
          (
            origin.modifiedAt is string &&
            origin.modifiedAt.size() == 24 &&
            origin.modifiedAt.matches(
              '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$'
            )
          )
        ) &&
        origin.importedVersion is int && origin.importedVersion > 0 &&
        origin.syncedAt is timestamp;
    }

    function validManagedArtifactOriginOnCreate() {
      return !request.resource.data.keys().hasAny(['origin']) ||
        (
          validManagedArtifactOrigin(request.resource.data.origin) &&
          request.resource.data.origin.importedVersion == request.resource.data.version &&
          request.resource.data.origin.syncedAt == request.time
        );
    }

    function validManagedArtifactOriginOnUpdate() {
      return !request.resource.data.keys().hasAny(['origin']) ||
        (
          validManagedArtifactOrigin(request.resource.data.origin) &&
          (
            (
              resource.data.keys().hasAny(['origin']) &&
              request.resource.data.origin == resource.data.origin
            ) ||
            (
              request.resource.data.origin.importedVersion == request.resource.data.version &&
              request.resource.data.origin.syncedAt == request.time
            )
          )
        );
    }

    function validManagedArtifactMetadata() {
      return request.resource.data.keys().hasAll([
          'path', 'pathKey', 'kind', 'description', 'tags', 'status', 'source',
          'version', 'sizeBytes', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'path', 'pathKey', 'kind', 'description', 'tags', 'status', 'source',
          'version', 'sizeBytes', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'deletedAt', 'origin'
        ]) &&
        request.resource.data.path is string && request.resource.data.path.size() > 0 && request.resource.data.path.size() <= 240 &&
        request.resource.data.pathKey is string && request.resource.data.pathKey.size() > 0 && request.resource.data.pathKey.size() <= 240 &&
        request.resource.data.kind in [
          'markdown', 'guideline', 'agent', 'orchestrator', 'skill', 'workflow', 'prompt', 'config', 'other'
        ] &&
        request.resource.data.description is string && request.resource.data.description.size() <= 320 &&
        request.resource.data.tags is list && request.resource.data.tags.size() <= 8 &&
        request.resource.data.status in ['active', 'trashed'] &&
        request.resource.data.source in ['created', 'imported', 'duplicated'] &&
        request.resource.data.version is int && request.resource.data.version > 0 &&
        request.resource.data.sizeBytes is int && request.resource.data.sizeBytes >= 0 && request.resource.data.sizeBytes <= 716800 &&
        validManagedArtifactActor(request.resource.data.createdBy) &&
        validManagedArtifactActor(request.resource.data.updatedBy) &&
        (
          !request.resource.data.keys().hasAny(['origin']) ||
          (
            validManagedArtifactOrigin(request.resource.data.origin) &&
            request.resource.data.origin.importedVersion <= request.resource.data.version
          )
        ) &&
        request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp &&
        (
          (request.resource.data.status == 'active' && !request.resource.data.keys().hasAny(['deletedAt'])) ||
          (request.resource.data.status == 'trashed' && request.resource.data.deletedAt is timestamp)
        );
    }

    function validManagedArtifactContent() {
      return request.resource.data.keys().hasAll(['content', 'sizeBytes', 'version', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['content', 'sizeBytes', 'version', 'updatedAt']) &&
        request.resource.data.content is string && request.resource.data.content.size() <= 716800 &&
        request.resource.data.sizeBytes is int && request.resource.data.sizeBytes >= 0 && request.resource.data.sizeBytes <= 716800 &&
        request.resource.data.version is int && request.resource.data.version > 0 &&
        request.resource.data.updatedAt is timestamp;
    }

    function validManagedArtifactPathLock() {
      return request.resource.data.keys().hasAll(['artifactId', 'pathKey', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['artifactId', 'pathKey', 'updatedAt']) &&
        request.resource.data.artifactId is string && request.resource.data.artifactId.size() > 0 &&
        request.resource.data.pathKey is string && request.resource.data.pathKey.size() > 0 && request.resource.data.pathKey.size() <= 240 &&
        request.resource.data.updatedAt is timestamp;
    }

    function hasMenuManagement() {
      return isAdmin() ||
        (
          signedIn() &&
          (
            request.auth.token.menuManagement == true ||
            request.auth.token.menuManager == true ||
            get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.permissions.menuManagement == true
          )
        );
    }

    function ownsIncomingUserId() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingUserId() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // Keep retired program namespaces outside permissive fallback rules until
    // their legacy data is removed with the Admin SDK.
    function isRetiredUserProgramCollection(collectionId) {
      return collectionId == 'emoticonJobs' ||
        collectionId == 'emoticonBatches' ||
        collectionId == 'emoticonStudioSourceAssetLocks' ||
        collectionId == 'emoticonStudioSourceAssets' ||
        collectionId == 'emoticonProjects';
    }

    function isRetiredServerProgramCollection(collection) {
      return collection == 'openrouter_daily_costs' ||
        collection == 'emoticonStudioRateLimits' ||
        collection == 'emoticonStudioOpenRouterRouteCache';
    }

    match /corpProjectBoards/{boardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if settingId == "general" || isAdmin();
      allow write: if isAdmin();
    }

    match /menuSettings/{settingId} {
      allow read: if true;
      allow write: if hasMenuManagement();
    }

    match /managedArtifacts/{artifactId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validManagedArtifactMetadata() &&
        validManagedArtifactOriginOnCreate() &&
        request.resource.data.version == 1 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validManagedArtifactMetadata() &&
        validManagedArtifactOriginOnUpdate() &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() && resource.data.status == 'trashed';
    }

    match /managedArtifactContents/{artifactId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validManagedArtifactContent() &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() &&
        !existsAfter(/databases/$(database)/documents/managedArtifacts/$(artifactId));
    }

    match /managedArtifactPaths/{pathId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validManagedArtifactPathLock() &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /corpPages/{pageId} {
      allow read: if true;
      allow write: if hasMenuManagement();
    }

    match /corpPageDrafts/{pageId} {
      allow read, write: if hasMenuManagement();
    }

    match /corpPageVersions/{versionId} {
      allow read, write: if hasMenuManagement();
    }

    match /admins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    match /userAccess/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    match /serverRateLimits/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rateLimits/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /storyboardArtifactCleanupCandidates/{candidateId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /{collectionId}/{document=**} {
        allow read, write: if (isOwner(userId) || isAdmin()) &&
          !isRetiredUserProgramCollection(collectionId) &&
          collectionId != 'storyboardArtifactCleanupCandidates';
      }
    }

    match /driveItems/{itemId} {
      allow read, delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId);
      allow create: if isAdmin() || (signedIn() && request.resource.data.ownerId == request.auth.uid);
    }

    match /video_studio_projects/{projectId} {
      allow read, delete: if isAdmin() || ownsExistingUserId();
      allow update: if isAdmin() || (ownsExistingUserId() && ownsIncomingUserId());
      allow create: if isAdmin() || ownsIncomingUserId();
    }

    match /video_studio_clips/{clipId} {
      allow read, delete: if isAdmin() || ownsExistingUserId();
      allow update: if isAdmin() || (ownsExistingUserId() && ownsIncomingUserId());
      allow create: if isAdmin() || ownsIncomingUserId();
    }

    match /video_studio_jobs/{jobId} {
      allow read: if isAdmin() || ownsExistingUserId();
      // Video jobs can spend the shared provider balance. Every write must go
      // through the authenticated server routes, which validate ownership,
      // worker compatibility, pricing, idempotency and recovery invariants.
      allow create, update, delete: if isAdmin();
    }

    match /ai_generations/{imageId} {
      allow read, delete: if isAdmin() || ownsExistingUserId();
      allow update: if isAdmin() || (ownsExistingUserId() && ownsIncomingUserId());
      allow create: if isAdmin() || ownsIncomingUserId();
    }

    match /bookmarks/{bookmarkId} {
      allow read, delete: if isAdmin() || ownsExistingUserId();
      allow update: if isAdmin() || (ownsExistingUserId() && ownsIncomingUserId());
      allow create: if isAdmin() || ownsIncomingUserId();
    }

    match /categories/{categoryId} {
      allow read, delete: if isAdmin() || ownsExistingUserId();
      allow update: if isAdmin() || (ownsExistingUserId() && ownsIncomingUserId());
      allow create: if isAdmin() || ownsIncomingUserId();
    }

    match /{collection}/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
        collection != 'users' &&
        collection != 'openrouter_usage' &&
        !isRetiredServerProgramCollection(collection) &&
        collection != 'serverRateLimits' &&
        collection != 'rateLimits' &&
        collection != 'managedArtifacts' &&
        collection != 'managedArtifactContents' &&
        collection != 'managedArtifactPaths';
    }
  }
}
