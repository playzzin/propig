<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101821"
    android:orientation="vertical"
    android:padding="10dp">
    <TextView android:id="@+id/habit_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="오늘 습관" android:textColor="#8EF0B9" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/habit_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="불러오는 중" android:textColor="#CAD6E1" android:textSize="12sp" />
    <TextView android:id="@+id/habit_row_0" style="@style/HabitWidgetRow" />
    <TextView android:id="@+id/habit_row_1" style="@style/HabitWidgetRow" />
    <TextView android:id="@+id/habit_row_2" style="@style/HabitWidgetRow" />
    <TextView android:id="@+id/habit_row_3" style="@style/HabitWidgetRow" />
    <TextView android:id="@+id/habit_row_4" style="@style/HabitWidgetRow" />
    <TextView android:id="@+id/habit_widget_refresh" android:layout_width="match_parent" android:layout_height="30dp"
        android:gravity="center_vertical" android:text="새로고침" android:textColor="#8EF0B9" android:textSize="13sp" />
</LinearLayout>
