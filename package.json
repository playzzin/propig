    "verify:navigation-performance": "node scripts/verify-navigation-performance.mjs",
    "verify:corp-pages": "node scripts/verify-corp-pages.mjs",
    "verify:calculator": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-safe-calculator.mjs",
